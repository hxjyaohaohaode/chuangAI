{
    "name": "poetic-realm-v5-backend",
    "version": "5.0.0",
    "packageManager": "pnpm@10.34.5",
    "engines": {
        "node": ">=24.11 <25"
    },
    "description": "诗脉·启明 PoeticRealm AI v5.0 后端 - 异构多智能体编排服务",
    "type": "module",
    "main": "src/server.ts",
    "scripts": {
        "dev": "nodemon --exec tsx src/server.ts",
        "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json",
        "start": "node dist/server.js",
        "lint": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:closed-loop": "node scripts/clean-dist.mjs && tsc -p tsconfig.json && node scripts/run-closed-loop-isolated.mjs",
        "test:routes": "node scripts/clean-dist.mjs && tsc -p tsconfig.json && node scripts/run-route-smoke-isolated.mjs",
        "auth:hash-password": "node scripts/hash-auth-password.mjs",
        "seed:learning": "tsx src/db/seed/seed-learning-demo.ts",
        "seed:learning:clear": "tsx src/db/seed/seed-learning-demo.ts --clear"
    },
    "dependencies": {
        "@fastify/cors": "^11.3.0",
        "@fastify/helmet": "^13.1.0",
        "@fastify/multipart": "^10.1.0",
        "@fastify/static": "^10.1.2",
        "@fastify/websocket": "^11.3.0",
        "better-sqlite3": "12.11.1",
        "dotenv": "^16.4.5",
        "fastify": "^5.12.5",
        "neo4j-driver": "^5.24.0",
        "openai": "^4.67.0",
        "pino": "^10.3.1",
        "pino-pretty": "^11.3.0",
        "sharp": "^0.35.4",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^7.6.11",
        "@types/node": "^24.19.0",
        "@types/ws": "^8.18.1",
        "@vitest/coverage-v8": "^4.1.10",
        "nodemon": "^3.1.7",
        "tsx": "^4.22.4",
        "typescript": "^5.6.2",
        "vitest": "^4.1.10",
        "ws": "^8.21.0"
    }
}
