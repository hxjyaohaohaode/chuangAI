# ============================================
# 诗脉·启明 PoeticRealm AI v5.0 环境变量示例
# 复制此文件为 .env 并填入真实值
# ============================================

# DeepSeek API（仅支持 deepseek-v4-flash / deepseek-v4-pro）
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# MiMo API（mimo-v2.5 / mimo-v2.5-pro / mimo-v2.5-tts / mimo-v2.5-asr）
MIMO_API_KEY=your_mimo_api_key
MIMO_BASE_URL=https://api.xiaomimimo.com/v1

# 阿里云百炼 Wan2.7-Image（可选；Key 或 Workspace 端点缺失时使用明确标记的本地占位图）
# 仅填写百炼 API Key，不需要也不要填写 RAM AccessKey；将 your-workspace-id 替换为真实业务空间 ID。
DASHSCOPE_API_KEY=your_dashscope_api_key
WAN_IMAGE_MODEL=wan2.7-image
WAN_IMAGE_BASE_URL=https://your-workspace-id.cn-beijing.maas.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation

# Neo4j 图数据库
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# 本机演示也建议使用随机长密码；留空时知识图谱降级，Docker Compose 会拒绝启动。
NEO4J_PASSWORD=

# 后端服务
PORT=3001
HOST=127.0.0.1
NODE_ENV=development
# 所有运行时可变资产的数据根。留空时使用项目 ./data；Render 蓝图固定为 /var/data。
APP_DATA_DIR=
# 仅需覆盖默认数据库文件名时设置；留空时使用 APP_DATA_DIR/poetic-realm.db。
SQLITE_PATH=
# 自定义公网域名的精确 HTTPS Origin，多个值用逗号分隔；禁止路径、凭据和通配符。
PUBLIC_APP_ORIGINS=
# Render Web Service 会自动注入，普通本地环境不得伪造或手填。
RENDER_EXTERNAL_URL=
# Render Web Service 会自动注入 true；本地必须保持 false，Render 上不得覆盖。
RENDER=false
# 本机无 Key 演示设 true；真实模型验证设 false 并提供相应凭据。
DEMO_MODE=true
# 仅容器内部以 demo 认证监听 0.0.0.0、且宿主机入口明确绑定 127.0.0.1 时才可设 true。
# 密码认证 + HTTPS 部署不需要该例外；裸机 demo/HTTP 部署必须保持 false。
ALLOW_UNAUTHENTICATED_NON_LOOPBACK=false

# 教师服务端认证：本机竞赛演示用 demo；真实/非回环部署必须用 password。
AUTH_MODE=demo
# demo 留空时每次启动生成随机密钥（重启需重新登录）；password 必须至少 32 字符，
# 且必须存入部署平台密钥管理，不得提交真实值。
AUTH_SESSION_SECRET=
AUTH_SESSION_TTL_MINUTES=480
# 本机 HTTP 用 auto；HTTPS 反向代理/非回环部署必须设 true。
AUTH_COOKIE_SECURE=auto
AUTH_TEACHER_ID=teacher-001
AUTH_TEACHER_NAME=王雅琴
# 运行 `cd backend && pnpm auth:hash-password` 交互生成；demo 模式保持空。
AUTH_PASSWORD_SCRYPT=

# 仅在确实轮换本轮审查中曾暴露的模型凭据后改为 true；不得提前填写。
CREDENTIALS_ROTATED_AFTER_AUDIT=false

# Vite 开发代理目标。裸机保持默认；Docker Compose 会覆盖为 http://backend:3001。
VITE_DEV_PROXY_TARGET=http://127.0.0.1:3001
