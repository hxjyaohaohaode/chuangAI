{
  /*
   * Vite 配置文件的类型检查工程（composite reference）
   *
   * 关键：必须 noEmit + emitDeclarationOnly=false。
   * composite 工程默认会产出 .js/.d.ts，于是 `tsc -b` 会在 frontend/ 根目录
   * 生成 vite.config.js 与 vite.config.d.ts。而 Vite 解析配置时 .js 优先于 .ts，
   * 之后对 vite.config.ts 的任何修改都会被那份陈旧的 .js **静默忽略**——
   * 曾因此导致分包策略改了没生效、排查半天。
   *
   * composite 又要求必须能产出声明文件，因此把产物指向 node_modules/.tmp，
   * 既满足 composite 约束，又不会污染项目根目录、不会遮蔽 .ts 配置。
   */
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "emitDeclarationOnly": true,
    "declarationDir": "./node_modules/.tmp/vite-config-types",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  "include": ["vite.config.ts"]
}
